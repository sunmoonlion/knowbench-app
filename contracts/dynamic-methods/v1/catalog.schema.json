{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.sunmoonai.com/knowbench/dynamic-methods/v1/catalog.schema.json",
  "$defs": {
    "AcceptanceRule": {
      "additionalProperties": false,
      "description": "确定性检查。kind 决定怎么判；judge 全是纯函数（application/workbench/acceptance.py）。",
      "properties": {
        "kind": {
          "enum": [
            "json_object",
            "required_keys",
            "non_empty",
            "list_min",
            "no_positioning_advice",
            "max_chars",
            "all_equal",
            "list_empty",
            "blank",
            "computed",
            "identity",
            "sourced",
            "quoted",
            "each_has",
            "covers"
          ],
          "title": "Kind",
          "type": "string"
        },
        "keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Keys",
          "type": "array"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "min_items": {
          "default": 1,
          "title": "Min Items",
          "type": "integer"
        },
        "max_chars": {
          "default": 20000,
          "title": "Max Chars",
          "type": "integer"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "equals": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equals"
        },
        "values": {
          "default": [],
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Values",
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "source_field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Field"
        },
        "also": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Also",
          "type": "array"
        },
        "tolerance": {
          "default": 0,
          "minimum": 0,
          "title": "Tolerance",
          "type": "number"
        },
        "expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expression"
        },
        "expected_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Value"
        },
        "input_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Input Keys",
          "type": "array"
        },
        "non_empty_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Non Empty Keys",
          "type": "array"
        },
        "unique_by": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Unique By",
          "type": "array"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "label": {
          "default": "",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "AcceptanceRule",
      "type": "object"
    },
    "AskBefore": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "options": {
          "default": [],
          "items": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object"
          },
          "title": "Options",
          "type": "array"
        },
        "allow_other": {
          "default": true,
          "title": "Allow Other",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "question"
      ],
      "title": "AskBefore",
      "type": "object"
    },
    "McpRequirement": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Url",
          "type": "string"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "url",
        "name"
      ],
      "title": "McpRequirement",
      "type": "object"
    },
    "MethodCapabilities": {
      "additionalProperties": false,
      "properties": {
        "tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/McpRequirement"
          },
          "maxItems": 30,
          "title": "Tools",
          "type": "array"
        },
        "skills": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SkillRequirement"
          },
          "maxItems": 10,
          "title": "Skills",
          "type": "array"
        }
      },
      "title": "MethodCapabilities",
      "type": "object"
    },
    "MethodContract": {
      "additionalProperties": false,
      "description": "Same execution contract, with bounded counts for repeatable catalog methods.",
      "properties": {
        "step_id": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$",
          "title": "Step Id",
          "type": "string"
        },
        "step_version": {
          "default": "1",
          "title": "Step Version",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "summary": {
          "default": "",
          "title": "Summary",
          "type": "string"
        },
        "why": {
          "default": "",
          "title": "Why",
          "type": "string"
        },
        "input_refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Input Refs",
          "type": "array"
        },
        "method_text": {
          "title": "Method Text",
          "type": "string"
        },
        "managed_capabilities": {
          "anyOf": [
            {
              "$ref": "#/$defs/MethodCapabilities"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Tools",
          "type": "array"
        },
        "output_artifact": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,47}$",
          "title": "Output Artifact",
          "type": "string"
        },
        "output_schema": {
          "additionalProperties": true,
          "title": "Output Schema",
          "type": "object"
        },
        "acceptance": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AcceptanceRule"
          },
          "title": "Acceptance",
          "type": "array"
        },
        "on_reject": {
          "default": "rework",
          "enum": [
            "rework",
            "back",
            "human"
          ],
          "title": "On Reject",
          "type": "string"
        },
        "back_to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Back To"
        },
        "max_reworks": {
          "default": 1,
          "maximum": 5,
          "minimum": 0,
          "title": "Max Reworks",
          "type": "integer"
        },
        "max_backs": {
          "default": 1,
          "maximum": 5,
          "minimum": 0,
          "title": "Max Backs",
          "type": "integer"
        },
        "mode": {
          "default": "single",
          "enum": [
            "single",
            "compete"
          ],
          "title": "Mode",
          "type": "string"
        },
        "reserve": {
          "default": "0.05",
          "title": "Reserve",
          "type": "string"
        },
        "input_max_chars": {
          "default": 8000,
          "maximum": 200000,
          "minimum": 500,
          "title": "Input Max Chars",
          "type": "integer"
        },
        "tool_policy": {
          "anyOf": [
            {
              "$ref": "#/$defs/ToolPolicyOverride"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ask_before": {
          "default": [],
          "items": {
            "$ref": "#/$defs/AskBefore"
          },
          "title": "Ask Before",
          "type": "array"
        },
        "output_file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output File"
        }
      },
      "required": [
        "step_id",
        "title",
        "method_text",
        "output_artifact"
      ],
      "title": "MethodContract",
      "type": "object"
    },
    "MethodSelection": {
      "additionalProperties": false,
      "properties": {
        "applies_when": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Applies When",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "max_calls": {
          "maximum": 100,
          "minimum": 1,
          "title": "Max Calls",
          "type": "integer"
        }
      },
      "required": [
        "applies_when",
        "required",
        "max_calls"
      ],
      "title": "MethodSelection",
      "type": "object"
    },
    "MethodUnit": {
      "additionalProperties": false,
      "properties": {
        "selection": {
          "$ref": "#/$defs/MethodSelection"
        },
        "contract": {
          "$ref": "#/$defs/MethodContract"
        }
      },
      "required": [
        "selection",
        "contract"
      ],
      "title": "MethodUnit",
      "type": "object"
    },
    "PlanningContract": {
      "additionalProperties": false,
      "properties": {
        "method_text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Method Text",
          "type": "string"
        },
        "final_units": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "minItems": 1,
          "title": "Final Units",
          "type": "array"
        },
        "max_steps": {
          "maximum": 100,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "max_replans": {
          "maximum": 10,
          "minimum": 0,
          "title": "Max Replans",
          "type": "integer"
        },
        "reserve": {
          "pattern": "^[0-9]{1,4}(\\.[0-9]{1,4})?$",
          "title": "Reserve",
          "type": "string"
        },
        "input_max_chars": {
          "maximum": 200000,
          "minimum": 500,
          "title": "Input Max Chars",
          "type": "integer"
        }
      },
      "required": [
        "method_text",
        "final_units",
        "max_steps",
        "max_replans",
        "reserve",
        "input_max_chars"
      ],
      "title": "PlanningContract",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "description": "这位专家接什么、不接什么。第一步先按它判问题是不是给这位专家的（受理关口，账 130）。\n\n不写就从六问的「解决什么」「不解决什么」里取，六问没写的再用名字与一句话介绍：分身的清单不用改也有这道关口。",
      "properties": {
        "does": {
          "title": "Does",
          "type": "string"
        },
        "does_not": {
          "default": "",
          "title": "Does Not",
          "type": "string"
        },
        "elsewhere": {
          "default": "",
          "title": "Elsewhere",
          "type": "string"
        }
      },
      "required": [
        "does"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SkillRequirement": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "maxLength": 50,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "required_tools": {
          "default": [],
          "items": {
            "$ref": "#/$defs/McpRequirement"
          },
          "maxItems": 30,
          "title": "Required Tools",
          "type": "array"
        }
      },
      "required": [
        "name",
        "version",
        "digest"
      ],
      "title": "SkillRequirement",
      "type": "object"
    },
    "ToolPolicyOverride": {
      "additionalProperties": false,
      "description": "步骤级覆盖。每一项都可以不给；给了只能更严，command_allow 只能加。",
      "properties": {
        "file_change_in_project": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "ask",
                "deny"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Change In Project"
        },
        "file_change_outside": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "ask",
                "deny"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "File Change Outside"
        },
        "command": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "ask",
                "deny"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Command"
        },
        "command_allow": {
          "default": [],
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Command Allow",
          "type": "array"
        },
        "network": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "ask",
                "deny"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network"
        },
        "questions": {
          "anyOf": [
            {
              "enum": [
                "allow",
                "deny"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Questions"
        },
        "max_questions": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Questions"
        }
      },
      "title": "ToolPolicyOverride",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "runtime_contract": {
      "const": "knowbench/dynamic-methods/v1",
      "title": "Runtime Contract",
      "type": "string"
    },
    "pack_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Pack Id",
      "type": "string"
    },
    "version": {
      "pattern": "^[1-9][0-9]{0,5}$",
      "title": "Version",
      "type": "string"
    },
    "title": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "name": {
      "default": "",
      "maxLength": 80,
      "title": "Name",
      "type": "string"
    },
    "tagline": {
      "default": "",
      "maxLength": 200,
      "title": "Tagline",
      "type": "string"
    },
    "scope": {
      "$ref": "#/$defs/Scope"
    },
    "planning": {
      "$ref": "#/$defs/PlanningContract"
    },
    "method_units": {
      "items": {
        "$ref": "#/$defs/MethodUnit"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Method Units",
      "type": "array"
    }
  },
  "required": [
    "runtime_contract",
    "pack_id",
    "version",
    "title",
    "scope",
    "planning",
    "method_units"
  ],
  "title": "DynamicMethodCatalog",
  "type": "object"
}
